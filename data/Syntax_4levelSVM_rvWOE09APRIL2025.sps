* Encoding: UTF-8.

DATASET ACTIVATE DataSet1.
MIXED LogitSVM BY drug SG ADR
  /CRITERIA=DFMETHOD(SATTERTHWAITE) CIN(95) MXITER(100) MXSTEP(10) SCORING(10) 
    SINGULAR(0.000000000001) HCONVERGE(0.00000001, RELATIVE) LCONVERGE(0, ABSOLUTE) PCONVERGE(0, 
    ABSOLUTE)
  /FIXED=| SSTYPE(3)
  /METHOD=ML
  /PRINT=COVB G  R TESTCOV
  /RANDOM=INTERCEPT | SUBJECT(drug) COVTYPE(CS)
  /RANDOM=INTERCEPT | SUBJECT(SG*drug) COVTYPE(CS)
  /RANDOM=INTERCEPT | SUBJECT(SG*ADR) COVTYPE(CS)
  /SAVE=PRED.
